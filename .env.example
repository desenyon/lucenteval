# ── App ──────────────────────────────────────────────────────────────────────
ENV=local
DEBUG=true
SECRET_KEY=change-me-in-production-use-32-chars-min

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lucent:lucent@localhost:5432/lucenteval
DATABASE_URL_SYNC=postgresql+psycopg2://lucent:lucent@localhost:5432/lucenteval

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── S3 / MinIO ───────────────────────────────────────────────────────────────
S3_BUCKET=lucenteval-responses
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=lucenteval
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Rate limiting ─────────────────────────────────────────────────────────────
DEFAULT_RATE_LIMIT_RPM=60

# ── Corpus ───────────────────────────────────────────────────────────────────
CORPUS_VERSION=v1

# ── Scoring weights (v1) ─────────────────────────────────────────────────────
WEIGHT_ADVERSARIAL=0.25
WEIGHT_TOOL_MISUSE=0.20
WEIGHT_HALLUCINATION=0.20
WEIGHT_RECOVERY=0.15
WEIGHT_LATENCY=0.10
WEIGHT_COST=0.10

# ── Platform ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
